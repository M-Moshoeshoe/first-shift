{
  "name": "first-shift",
  "version": "0.1.0",
  "private": true,
  "description": "Paid one-day tryouts at local businesses, with references from the business that paid.",
  "engines": {
    "node": ">=24.12 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "vitest run --config vitest.rules.config.mts",
    "rules": "firebase emulators:exec --project demo-first-shift --only firestore,storage \"npm run test:rules\"",
    "emulators": "firebase emulators:start --project demo-first-shift --only auth,firestore,storage",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run budget",
    "verify": "npm run check && npm audit",
    "budget": "tsx scripts/budget.ts",
    "e2e:profile": "tsx scripts/e2e/profile.ts",
    "e2e:photo": "tsx scripts/e2e/photo.ts",
    "e2e:browser": "tsx scripts/e2e/browser.ts",
    "e2e:demo": "tsx scripts/e2e/demo.ts",
    "eval:ai": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/evalAi.ts",
    "credits:backfill": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/backfillCredits.ts",
    "credits:grant": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/grantCredits.ts",
    "review:tryout": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/reviewTryout.ts",
    "demo:accounts": "tsx --conditions=react-server --env-file-if-exists=.env.local --env-file-if-exists=.env.demo.local scripts/createDemoAccounts.ts",
    "demo:reset": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/resetDemo.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.132.1",
    "firebase": "13.0.0",
    "firebase-admin": "14.5.0",
    "geofire-common": "6.0.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "firebase-tools": "15.34.1",
    "playwright-core": "1.64.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6",
    "firebase-tools": {
      "gaxios": {
        "uuid": "11.1.1"
      },
      "@google-cloud/pubsub": {
        "@opentelemetry/core": "2.8.0"
      }
    },
    "firebase-admin": {
      "jwks-rsa": "3.2.2"
    }
  }
}
