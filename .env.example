# Copy this file to .env.local and fill in the values for real services. Never commit .env.local.
# Emulator settings go in .env.development.local instead (see the end of this file and README section 5).

# Firebase web app settings (Firebase console > Project settings > Your apps > Web app).
# These are public by design; Firestore rules protect the data.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Firebase console > Project settings > Cloud Messaging > Web Push certificates.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Firebase Admin (Project settings > Service accounts > Generate new private key).
# Server only. Paste the private key with its \n escapes intact.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Anthropic API key (console.anthropic.com). Server only.
ANTHROPIC_API_KEY=

# A long random secret for hashing ID numbers. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ID_HASH_SECRET=

# Optional: AI requests per user per day (default 30).
AI_DAILY_REQUESTS_PER_USER=30

# Emulators: do NOT set these in .env.local. Put them in .env.development.local, which npm run dev
# reads before .env.local (the first value found wins) and production builds never read.
# While they're set there, real settings in .env.local are ignored; remove them to use real services.
# The browser connects to the emulators only when this is "true" AND the page is on localhost or 127.0.0.1.
# /api/health reports "emulators": true while it or any host below is set; it must be false on the live site.
NEXT_PUBLIC_USE_EMULATORS=
# Server side, for the Admin SDK. Set together with the switch above, in .env.development.local only.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
