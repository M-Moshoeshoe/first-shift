rules_version = '2';

// Profile and shopfront photos only. Each user writes only to their own folder,
// images only, under 2 MB. Permit and refugee ID uploads come after the hackathon.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }

    match /photos/{uid}/{fileName} {
      // Your own photos only. Anyone else's comes through the server, which checks you're linked
      // (an application or a booking between you), so demo and real accounts never see each other's.
      allow read: if request.auth != null && request.auth.uid == uid;
      // Demo accounts have public passwords, so nobody may put a photo of themselves on one.
      allow write: if request.auth != null
        && request.auth.token.get("demo", false) != true
        && request.auth.uid == uid
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
  }
}
